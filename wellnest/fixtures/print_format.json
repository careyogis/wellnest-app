  "html": "<div class=\"settlement-advice\" style=\"font-family: Arial, sans-serif; font-size: 12px; color: #333; padding: 20px;\">\n    {% set practitioner = frappe.get_doc(\"Practitioner\", doc.practitioner) if doc.practitioner else None %}\n    <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e5e7eb; padding-bottom: 16px; margin-bottom: 20px;\">\n        <div>\n            <h1 style=\"margin: 0; font-size: 22px; color: #1f2937; font-weight: bold;\">CareYogi</h1>\n            <p style=\"margin: 4px 0 0; color: #6b7280; font-size: 13px;\">Practitioner Payout Settlement Advice</p>\n        </div>\n        <div style=\"text-align: right;\">\n            <div style=\"font-size: 16px; font-weight: bold; color: #111827;\">{{ doc.name }}</div>\n            <div style=\"color: #6b7280; font-size: 12px; margin-top: 4px;\">Status: <strong>{{ doc.status }}</strong></div>\n        </div>\n    </div>\n    <table style=\"width: 100%; margin-bottom: 24px; border-collapse: collapse;\">\n        <tr>\n            <td style=\"width: 50%; vertical-align: top; padding-right: 12px;\">\n                <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px;\">\n                    <div style=\"font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin-bottom: 6px;\">Doctor Details</div>\n                    <div style=\"font-size: 14px; font-weight: bold; color: #111827;\">{{ doc.practitioner_name }}</div>\n                    {% if practitioner and practitioner.specialty %}\n                    <div style=\"color: #4b5563; font-size: 12px; margin-top: 2px;\">{{ practitioner.specialty }}</div>\n                    {% endif %}\n                    {% if practitioner and practitioner.registration_no %}\n                    <div style=\"color: #6b7280; font-size: 11px; margin-top: 4px;\">Reg No: {{ practitioner.registration_no }}</div>\n                    {% endif %}\n                </div>\n            </td>\n            <td style=\"width: 50%; vertical-align: top; padding-left: 12px;\">\n                <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px;\">\n                    <div style=\"font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin-bottom: 6px;\">Payout Cycle & Payment</div>\n                    <div style=\"font-size: 13px; color: #111827;\">Period: <strong>{{ frappe.format(doc.cycle_start_date, {\"fieldtype\": \"Date\"}) }}</strong> to <strong>{{ frappe.format(doc.cycle_end_date, {\"fieldtype\": \"Date\"}) }}</strong></div>\n                    <div style=\"font-size: 13px; color: #111827; margin-top: 4px;\">Disbursed On: <strong>{{ frappe.format(doc.payout_date, {\"fieldtype\": \"Date\"}) if doc.payout_date else \"Pending\" }}</strong></div>\n                    {% if doc.payment_reference %}\n                    <div style=\"font-size: 12px; color: #047857; margin-top: 4px; font-weight: bold;\">UTR / Ref: {{ doc.payment_reference }}</div>\n                    {% endif %}\n                </div>\n            </td>\n        </tr>\n    </table>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 24px;\">\n        <thead>\n            <tr style=\"background: #f3f4f6; border-bottom: 2px solid #d1d5db;\">\n                <th style=\"padding: 8px 10px; text-align: left; font-size: 11px; font-weight: bold; color: #374151;\">#</th>\n                <th style=\"padding: 8px 10px; text-align: left; font-size: 11px; font-weight: bold; color: #374151;\">Appointment</th>\n                <th style=\"padding: 8px 10px; text-align: left; font-size: 11px; font-weight: bold; color: #374151;\">Date & Time</th>\n                <th style=\"padding: 8px 10px; text-align: left; font-size: 11px; font-weight: bold; color: #374151;\">Patient</th>\n                <th style=\"padding: 8px 10px; text-align: right; font-size: 11px; font-weight: bold; color: #374151;\">Customer Fee</th>\n                <th style=\"padding: 8px 10px; text-align: right; font-size: 11px; font-weight: bold; color: #374151;\">Payout Rate</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            {% set appt = frappe.get_doc(\"Patient Appointment\", item.patient_appointment) if item.patient_appointment else None %}\n            {% set patient_name = frappe.db.get_value(\"Patient\", appt.patient, \"full_name\") if (appt and appt.patient) else \"\" %}\n            <tr style=\"border-bottom: 1px solid #e5e7eb;\">\n                <td style=\"padding: 8px 10px; color: #6b7280;\">{{ loop.index }}</td>\n                <td style=\"padding: 8px 10px; font-weight: 500; color: #111827;\">{{ item.patient_appointment }}</td>\n                <td style=\"padding: 8px 10px; color: #4b5563;\">{{ frappe.format(appt.scheduled_time, {\"fieldtype\": \"Datetime\"}) if appt else \"\" }}</td>\n                <td style=\"padding: 8px 10px; color: #111827;\">{{ patient_name }}</td>\n                <td style=\"padding: 8px 10px; text-align: right; color: #6b7280;\">{{ frappe.format(appt.consultation_fee, {\"fieldtype\": \"Currency\"}) if appt else \"\" }}</td>\n                <td style=\"padding: 8px 10px; text-align: right; font-weight: bold; color: #111827;\">{{ frappe.format(item.payout_rate, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    <div style=\"display: flex; justify-content: flex-end;\">\n        <table style=\"width: 320px; border-collapse: collapse; margin-left: auto;\">\n            <tr>\n                <td style=\"padding: 6px 10px; color: #4b5563;\">Total Consultations:</td>\n                <td style=\"padding: 6px 10px; text-align: right; font-weight: 600;\">{{ doc.consultation_count }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 6px 10px; color: #4b5563;\">Gross Amount:</td>\n                <td style=\"padding: 6px 10px; text-align: right; font-weight: 600;\">{{ frappe.format(doc.gross_amount, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n            {% if doc.adjustments %}\n            <tr>\n                <td style=\"padding: 6px 10px; color: #dc2626;\">Adjustments / Deductions:</td>\n                <td style=\"padding: 6px 10px; text-align: right; font-weight: 600; color: #dc2626;\">- {{ frappe.format(doc.adjustments, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n            {% endif %}\n            <tr style=\"border-top: 2px solid #111827;\">\n                <td style=\"padding: 8px 10px; font-size: 14px; font-weight: bold; color: #111827;\">Net Disbursed:</td>\n                <td style=\"padding: 8px 10px; text-align: right; font-size: 14px; font-weight: bold; color: #047857;\">{{ frappe.format(doc.net_payable_amount, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n        </table>\n    </div>\n    <div style=\"margin-top: 40px; border-top: 1px solid #e5e7eb; padding-top: 16px; font-size: 11px; color: #9ca3af; text-align: center;\">\n        This is an official system-generated settlement advice from CareYogi. For any discrepancies, please reach out to Care Operations.\n    </div>\n</div>",
