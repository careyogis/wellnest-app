[
 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "css": null,
  "custom_format": 1,
  "default_print_language": "en",
  "disabled": 0,
  "doc_type": "Smart Prescription",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<div class=\"prescription\">\r\n\r\n    {{ letter_head }}\r\n\r\n    {% set practitioner = frappe.get_doc(\"Practitioner\", doc.practitioner) if doc.practitioner else None %}\r\n    {% set patient = frappe.get_doc(\"Patient\", doc.patient) if doc.patient else None %}\r\n\r\n    {% set highest_degree = None %}\r\n\r\n    {% if practitioner and practitioner.education_history %}\r\n        {% set sorted_education = practitioner.education_history | sort(attribute=\"year_of_completion\") %}\r\n        {% if sorted_education %}\r\n            {% set highest_degree = sorted_education[-1] %}\r\n        {% endif %}\r\n    {% endif %}\r\n\r\n    <style>\r\n    @page {\r\n        margin: 10mm;\r\n    }\r\n\r\n    .prescription {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 12px;\r\n        line-height: 1.35;\r\n        background: #FFFDF7;\r\n        border: 1px solid #E8D39B;\r\n        border-radius: 14px;\r\n        overflow: hidden;\r\n        color: #222;\r\n    }\r\n\r\n    .content {\r\n        padding: 0 18px 18px;\r\n    }\r\n\r\n    .header {\r\n        padding: 8px 0 8px;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .header h2 {\r\n        margin: 0;\r\n        font-size: 17px;\r\n        font-weight: 700;\r\n        color: #0A2A4A;\r\n    }\r\n\r\n    .grid {\r\n        width: 100%;\r\n        border-collapse: separate;\r\n        border-spacing: 8px;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .card {\r\n        border: 1px solid #D8D8D8;\r\n        border-radius: 10px;\r\n        background: #FFF;\r\n        padding: 8px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .card-label {\r\n        font-size: 11px;\r\n        color: #777;\r\n        text-transform: uppercase;\r\n        letter-spacing: .4px;\r\n    }\r\n\r\n    .card-value {\r\n        margin-top: 4px;\r\n        font-size: 13px;\r\n        font-weight: 600;\r\n        color: #111;\r\n    }\r\n\r\n    .section {\r\n        margin-top: 9px;\r\n    }\r\n\r\n    .section h4 {\r\n        margin: 0 0 4px;\r\n        font-size: 15px;\r\n        font-weight: 700;\r\n        color: #0A2A4A;\r\n        border-bottom: 1px solid #D8D8D8;\r\n        padding-bottom: 3px;\r\n    }\r\n\r\n    .section p {\r\n        margin: 0;\r\n    }\r\n\r\n    .medicine-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n        margin-top: 6px;\r\n    }\r\n\r\n    .medicine-table thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    .medicine-table th {\r\n        background: #F5E3A7;\r\n        border: 1px solid #D8D8D8;\r\n        padding: 5px;\r\n        text-align: left;\r\n        font-size: 11px;\r\n        font-weight: 700;\r\n        color: #0A2A4A;\r\n    }\r\n\r\n    .medicine-table td {\r\n        border: 1px solid #D8D8D8;\r\n        padding: 5px;\r\n        font-size: 11px;\r\n        line-height: 1.3;\r\n        vertical-align: top;\r\n        word-break: break-word;\r\n    }\r\n    \r\n    .medicine-table tr {\r\n        page-break-inside: avoid;\r\n        break-inside: avoid;\r\n    }\r\n\r\n    .footer {\r\n        margin-top: 5px;\r\n        border-top: 1px solid #D8D8D8;\r\n        padding-top: 10px;\r\n        text-align: right;\r\n    }\r\n\r\n    .footer-note {\r\n        margin-top: 1px;\r\n        font-size: 8px;\r\n        color: #666;\r\n    }\r\n    </style>\r\n\r\n    <div class=\"content\">\r\n\r\n        <div class=\"header\">\r\n            <h2>Prescription</h2>\r\n        </div>\r\n\r\n        <!-- Patient Information -->\r\n        <table class=\"grid\">\r\n            <tr>\r\n                <td class=\"card\" width=\"50%\">\r\n                    <div class=\"card-label\">Patient</div>\r\n                    <div class=\"card-value\">\r\n                        {{ patient.full_name if patient else doc.patient }}\r\n                    </div>\r\n                </td>\r\n\r\n                <td class=\"card\" width=\"50%\">\r\n                    <div class=\"card-label\">Prescription Date</div>\r\n                    <div class=\"card-value\">\r\n                        {{ frappe.format(doc.prescription_date, {\"fieldtype\":\"Date\"}) }}\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n        <!-- Doctor Information -->\r\n        <table class=\"grid\">\r\n    <tr>\r\n        <td class=\"card\" width=\"100%\">\r\n            <div class=\"card-label\">Doctor</div>\r\n\r\n            <div class=\"card-value\">{{ practitioner.full_name if practitioner else \"-\" }}{% if highest_degree and highest_degree.degree %}, {{ highest_degree.degree }}{% endif %}{% if practitioner and practitioner.specialty %} {{ practitioner.specialty }}{% endif %}</div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n        <!-- Provisional Diagnosis -->\r\n        <div class=\"section\">\r\n            <h4>Provisional Diagnosis</h4>\r\n            <p>{{ doc.provisional_diagnosis or \"-\" }}</p>\r\n        </div>\r\n\r\n        <!-- Investigations -->\r\n        <div class=\"section\">\r\n            <h4>Investigations Advised</h4>\r\n            <p>{{ doc.investigations or \"-\" }}</p>\r\n        </div>\r\n\r\n        <!-- Medicines -->\r\n        <div class=\"section\">\r\n            <h4>Treatment / Medication</h4>\r\n\r\n            <table class=\"medicine-table\">\r\n                <colgroup>\r\n                    <col style=\"width:32%;\">\r\n                    <col style=\"width:13%;\">\r\n                    <col style=\"width:20%;\">\r\n                    <col style=\"width:12%;\">\r\n                    <col style=\"width:23%;\">\r\n                </colgroup>\r\n                <thead>\r\n                    <tr>\r\n                        <th>Medicine</th>\r\n                        <th>Dosage</th>\r\n                        <th>Timing</th>\r\n                        <th>Duration</th>\r\n                        <th>Instructions</th>\r\n                    </tr>\r\n                </thead>\r\n\r\n                <tbody>\r\n                    {% if doc.medicines %}\r\n\r\n                        {% for row in doc.medicines %}\r\n\r\n                        <tr>\r\n                            <td>\r\n                                <strong>{{ row.medicine_name }}</strong>\r\n\r\n                                {% if row.generic_names %}\r\n                                    <br>\r\n                                    <span style=\"font-size:10px;color:#666;\">\r\n                                        {{ row.generic_names }}\r\n                                    </span>\r\n                                {% endif %}\r\n                            </td>\r\n\r\n                            <td>\r\n                                {{ row.dosage or \"-\" }}\r\n                            </td>\r\n\r\n                            <td>\r\n                                {{ row.timing or \"-\" }}\r\n                            </td>\r\n\r\n                            <td>\r\n                                {{ row.duration or \"-\" }}\r\n                            </td>\r\n\r\n                            <td>\r\n                                {{ row.instructions or \"-\" }}\r\n\r\n                                {% if row.instruction_translation %}\r\n                                    <br>\r\n                                    <span style=\"font-size:10px;color:#666;\">\r\n                                        {{ row.instruction_translation }}\r\n                                    </span>\r\n                                {% endif %}\r\n                            </td>\r\n                        </tr>\r\n\r\n                        {% endfor %}\r\n\r\n                    {% else %}\r\n\r\n                        <tr>\r\n                            <td colspan=\"5\"\r\n                                style=\"text-align:center;color:#777;padding:10px;\">\r\n                                No medicines prescribed.\r\n                            </td>\r\n                        </tr>\r\n\r\n                    {% endif %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n\r\n        <!-- Doctor Advice -->\r\n        <div class=\"section\">\r\n            <h4>Doctor Advice</h4>\r\n            <p>{{ doc.doctor_advice or \"-\" }}</p>\r\n        </div>\r\n\r\n        <!-- Follow-up -->\r\n        <div class=\"section\">\r\n            <h4>Follow-up</h4>\r\n        \r\n            <p>\r\n                {% if doc.follow_up_in_days is not none %}\r\n                    {{ doc.follow_up_in_days }} days\r\n                {% else %}\r\n                    -\r\n                {% endif %}\r\n            </p>\r\n        </div>\r\n\r\n        <!-- Doctor Signature -->\r\n        <div class=\"footer\">\r\n\r\n            {% if practitioner and practitioner.digital_signature_url %}\r\n                <img src=\"{{ practitioner.digital_signature_url }}\"\r\n                     style=\"height:60px;margin-bottom:6px;\"><br>\r\n            {% endif %}\r\n\r\n            <strong>\r\n                {{ practitioner.full_name if practitioner else \"\" }}\r\n            </strong>\r\n\r\n            {% if practitioner and practitioner.registration_no %}\r\n                <br>\r\n                Registration No.: {{ practitioner.registration_no }}\r\n            {% endif %}\r\n\r\n            {% if practitioner and practitioner.council_name %}\r\n                <br>\r\n                Council: {{ practitioner.council_name }}\r\n            {% endif %}\r\n\r\n            <div class=\"footer-note\">\r\n                This is a digitally generated prescription.\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>",
